# 허브 설정 (필요할 때만 복사해서 .env 로 사용)
# Node 22+ 는 --env-file 옵션으로 읽을 수 있습니다: node --env-file=.env src/server.ts

HUB_HOST=0.0.0.0
HUB_PORT=4317
HUB_DATA_DIR=./data

# OCR 바이너리 경로 (기본: ../ocr/bin/ocr)
# OCR_BIN=/absolute/path/to/ocr/bin/ocr

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_ALT_MODEL=qwen2.5:14b-instruct

# 업로드 최대 크기 (기본 64MB). 사진 제한은 앱 설정에서 조절합니다.
HUB_BODY_LIMIT=67108864
LOG_LEVEL=info
